# ==========================================
# SkillBeacon Local Configuration (.env.local)
# ==========================================
# Copy this file to backend/.env.local to override settings for local development.
#
# Neon PostgreSQL:
# Uses Neon PostgreSQL directly without needing Docker.
#
# Optional: Override DATABASE_URL if you are using an isolated Neon dev branch
# (e.g. created via `neon branch create --name dev` / `neon connection-string dev`)
# DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@ep-dev-branch-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql+psycopg://neondb_owner:<password>@ep-dev-branch.<region>.aws.neon.tech/neondb?sslmode=require

# ==========================================
# Application Settings
# ==========================================
APP_NAME=SkillBeacon
APP_ENV=development
DEBUG=true

# ==========================================
# Neon PostgreSQL Database Configuration
# ==========================================
# Active Neon Database Branch
NEON_BRANCH=production

# Primary Pooled Connection URL (Used by FastAPI & SQLAlchemy via PgBouncer)
DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Direct / Unpooled Connection URL (Direct compute connection for migrations/admin tasks)
DATABASE_URL_UNPOOLED=postgresql+psycopg://neondb_owner:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require

# ==========================================
# Neon AI Gateway Configuration (Optional LLM Routing)
# ==========================================
NEON_AI_GATEWAY_TOKEN=nt_live_your_token_here
NEON_AI_GATEWAY_BASE_URL=https://<gateway-endpoint>.ai.<region>.aws.neon.tech

# ==========================================
# Neon Auth Configuration (Managed Better Auth)
# ==========================================
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json

# ==========================================
# JWT Authentication & Security (Fallback/Session)
# ==========================================
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# Frontend & Storage Configuration
# ==========================================
FRONTEND_URL=http://localhost:5173
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=5
VITE_API_URL=http://127.0.0.1:8000/api/v1

# ==========================================
# Cloudflare R2 Object Storage Configuration
# ==========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=skillbeacon-documents
R2_PUBLIC_BASE_URL=https://<account_id>.r2.cloudflarestorage.com/skillbeacon-documents